<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlexManager.View.ServersPage"
             xmlns:model="clr-namespace:PlexManager.Model"
             xmlns:viewmodel="clr-namespace:PlexManager.ViewModel"
             xmlns:plexapi="clr-namespace:PlexAPI;assembly=PlexAPI"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="viewmodel:ServersViewModel"
             Title="ServersPage">
    <ScrollView>
        <VerticalStackLayout Spacing="25">
            <CollectionView ItemsSource="{Binding Servers}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="plexapi:Server">
                        <Border Padding="15" Margin="10" StrokeShape="RoundRectangle 5">
                            <Grid Margin="-5,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Aspect="Center" Source="{mi:Material Dns}" />
                                
                                <VerticalStackLayout VerticalOptions="Center" Margin="15,0,0,0" Grid.Column="1">
                                    <Label Text="{Binding Name}" FontSize="18" TextColor="Gray"/>
                                    <Label Text="{Binding FullUri}" FontSize="14" TextColor="Gray"/>
                                </VerticalStackLayout>

                                <ImageButton Grid.Column="2"
                                             Aspect="Center"
                                             Source="{mi:Material ArrowForwardIos}"
                                             HorizontalOptions="End"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ServersViewModel}}, Path=NavigateToServerCommand}"
                                             CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
