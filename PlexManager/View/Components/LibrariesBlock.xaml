<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:bindparams="clr-namespace:PlexManager.Model.BindingParameters"
             xmlns:helpers="clr-namespace:PlexManager.Helpers"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:plexservermodels="clr-namespace:PlexAPI.Models.Servers;assembly=PlexAPI"
             xmlns:viewmodel="clr-namespace:PlexManager.ViewModel"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlexManager.View.Components.LibrariesBlock"
             x:DataType="viewmodel:SingleServerViewModel">
    <ContentView.Resources>
        <helpers:IconTypeConverter x:Key="IconTypeConverter" />
    </ContentView.Resources>

    <Border Padding="15"
        Margin="10,5,10,5"
        StrokeShape="RoundRectangle 5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Text="Libraries"
                   Grid.Row="0"
                   FontSize="Medium"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <Button Grid.Row="1"
                    Text="Update all"
                    CornerRadius="4"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:SingleServerViewModel}}, Path=UpdateAllLibrariesCommand}"
                    CommandParameter="{Binding Server}" />

            <VerticalStackLayout Grid.Row="2"
                                 Margin="0,5,0,0">
                <CollectionView ItemsSource="{Binding LibrariesWithServer}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="bindparams:ServerLibraryParameter">
                            <Grid Row="0" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <mi:MauiIcon Grid.Column="0"
                                             Icon="{Binding Library.Type, Converter={StaticResource IconTypeConverter}, Mode=OneWay}"
                                             VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding Library.Title}"
                                       VerticalOptions="Center"
                                       Margin="5,0,0,0"/>

                                <ImageButton Grid.Column="2"
                                             Source="{mi:Material ChevronRight}"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:SingleServerViewModel}}, Path=NavigateToSingleLibraryCommand}"
                                             CommandParameter="{Binding}" />

                                <!--
                                <mi:MauiIcon Grid.Column="2"
                                             Icon="{mi:Material ChevronRight}" />
                                -->
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
