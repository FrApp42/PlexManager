<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:plexservermodels="clr-namespace:PlexAPI.Models.Servers;assembly=PlexAPI"
             xmlns:viewmodel="clr-namespace:PlexManager.ViewModel"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlexManager.View.Components.UserListBlock"
             x:DataType="viewmodel:SingleServerViewModel">
    <Border Padding="15"
            Margin="10,5,10,5"
            StrokeShape="RoundRectangle 5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Text="Users"
                   Grid.Row="0"
                   FontSize="Medium"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <VerticalStackLayout Grid.Row="1"
                                 Margin="0,5,0,0">
                <CollectionView ItemsSource="{Binding UserList.Users}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="plexservermodels:User">
                            <Grid Row="0" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <mi:MauiIcon Grid.Column="0"
                                             Icon="{mi:Material Person}" />

                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center"
                                       Margin="5,0,0,0"/>

                                <mi:MauiIcon Grid.Column="2"
                                             Icon="{mi:Material ChevronRight}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
