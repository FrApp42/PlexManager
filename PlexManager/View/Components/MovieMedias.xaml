<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:plexservermodels="clr-namespace:PlexAPI.Models.Servers;assembly=PlexAPI"
             xmlns:viewmodel="clr-namespace:PlexManager.ViewModel"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlexManager.View.Components.MovieMedias"
             x:DataType="viewmodel:SingleLibraryViewModel">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding LibraryMovie.Videos}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="plexservermodels:LibraryMovieVideo">
                    <Grid Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image HeightRequest="50"
                               Aspect="AspectFit">
                            <Image.Source>
                                <UriImageSource Uri="{Binding ThumbUrl}"
                                                CachingEnabled="True"
                                                CacheValidity="30:00:00:00" />
                            </Image.Source>
                        </Image>

                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalOptions="Center"
                               Margin="5,0,0,0"/>

                        <ImageButton Grid.Column="2"
                                     Source="{mi:Material ChevronRight}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
