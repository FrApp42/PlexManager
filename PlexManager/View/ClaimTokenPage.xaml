<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlexManager.View.ClaimTokenPage"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:viewmodel="clr-namespace:PlexManager.ViewModel"
             x:DataType="viewmodel:ClaimTokenViewModel"
             Title="ClaimToken">
    <VerticalStackLayout>
        <Grid RowDefinitions="Auto,Auto,*">

            <BoxView
                BackgroundColor="{StaticResource Primary}"
                Grid.RowSpan="2"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"/>

            <Border StrokeShape="RoundRectangle 80"
                Stroke="White"
                StrokeThickness="6"
                HeightRequest="80"
                WidthRequest="80"
                Margin="0,8,0,0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                
                <Image Aspect="AspectFill"
                    HeightRequest="60"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Source="{mi:Material Key}"
                    WidthRequest="60"/>
            </Border>

            <Label Style="{StaticResource LargeLabel}" 
                Grid.Row="1"
                TextColor="White"
                FontAttributes="Bold"
                Text="First Start"
                HorizontalOptions="Center"
                Margin="0,0,0,8"/>

            <VerticalStackLayout Grid.Row="2" Padding="10" Spacing="10">
                
                <Label Text="Username" FontSize="18" Margin="0,10,0,0" />
                <Entry
                    Text="{Binding Username}"
                    />

                <Label Text="Password" FontSize="18" />
                <Entry
                    Placeholder="********" 
                    IsPassword="True" 
                    Text="{Binding Password}"
                    />

                <Label Text="2FA" FontSize="18" Margin="0,10,0,0" />
                <Entry
                    Text="{Binding Mfa}"
                    Keyboard="Numeric"
                    />

                <Button 
                    Text="Save"
                    Command="{Binding RunAuthCommand}"
                    />
            </VerticalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>