<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:components="clr-namespace:PlexManager.View.Components"
             xmlns:viewmodel="clr-namespace:PlexManager.ViewModel"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlexManager.View.SingleServerPage"
             x:DataType="viewmodel:SingleServerViewModel"
             Title="{Binding Server.Name}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <components:IdentityBlock />

                <components:LibrariesBlock />

                <components:UserListBlock />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
