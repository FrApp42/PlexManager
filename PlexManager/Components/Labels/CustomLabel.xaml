<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"             
             x:Class="PlexManager.Components.Labels.CustomLabel"
             xmlns:labels="clr-namespace:PlexManager.Components.Labels"
             x:Name="Root">
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCopyClicked" />
        </Grid.GestureRecognizers>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        

        <Label
            Grid.Column="0"
            HorizontalOptions="Start"
            Text="{Binding Source={x:Reference Root}, Path=StartText}" />

        <Label Grid.Column="1"
           HorizontalOptions="End"
           Text="{Binding Source={x:Reference Root}, Path=EndText}" />
    </Grid>
</ContentView>
