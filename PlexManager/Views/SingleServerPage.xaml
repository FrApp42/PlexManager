<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PlexManager.Views.SingleServerPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:PlexManager.Views.Components"
             xmlns:helpers="clr-namespace:PlexManager.Helpers"
             xmlns:vm="clr-namespace:PlexManager.ViewModels"
             Title="{Binding Server.Name}"
             x:DataType="vm:SingleServerViewModel">
    <ContentPage.Resources>
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ActivityIndicator HorizontalOptions="Center"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="Center" />

        <ScrollView Grid.Row="0"
                    Margin="0,5,0,5"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
            <VerticalStackLayout>
                <components:IdentityBlock />

                <components:LibrariesBlock />

                <components:UserListBlock />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
