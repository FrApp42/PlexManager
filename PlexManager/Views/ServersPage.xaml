<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PlexManager.Views.ServersPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:models="clr-namespace:PlexManager.Models"
             xmlns:plexapi="clr-namespace:PlexAPI;assembly=PlexAPI"
             xmlns:vm="clr-namespace:PlexManager.ViewModels"
             Title="ServersPage"
             x:DataType="vm:ServersViewModel">
    <RefreshView 
        IsRefreshing="{Binding IsLoading}"
        Command="{Binding LoadServersCommand}"
        >
        <ScrollView>
            <VerticalStackLayout Spacing="25">

                <CollectionView ItemsSource="{Binding Servers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="plexapi:Server">
                            <Border Margin="10"
                                    Padding="15"
                                    StrokeShape="RoundRectangle 5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServersViewModel}}, Path=NavigateToServerCommand}"
                                        CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>
                                <Grid Margin="-5,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Aspect="Center"
                                           Source="{mi:Material Dns}" />

                                    <VerticalStackLayout Grid.Column="1"
                                                         Margin="15,0,0,0"
                                                         VerticalOptions="Center">
                                        <Label FontSize="18"
                                               Text="{Binding Name}"
                                               TextColor="Gray" />

                                        <Label FontSize="14"
                                               Text="{Binding FullUri}"
                                               TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <ImageButton Grid.Column="2"
                                                 Aspect="Center"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServersViewModel}}, Path=NavigateToServerCommand}"
                                                 CommandParameter="{Binding}"
                                                 HorizontalOptions="End"
                                                 Source="{mi:Material ArrowForwardIos}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
