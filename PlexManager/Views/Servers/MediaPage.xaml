<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlexManager.Views.Servers.MediaPage"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:helpers="clr-namespace:PlexManager.Helpers"
             xmlns:vm="clr-namespace:PlexManager.ViewModels.Servers"
             x:DataType="vm:MediaViewModel"
             Title="{Binding Media.Title}">
    <ContentPage.Resources>
        <helpers:BigIntToTimeString x:Key="BigIntToTimeString" />
    </ContentPage.Resources>

    <Grid Padding="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ffimageloading:CachedImage 
            Grid.Row="0"
            Grid.Column="0"
            Aspect="AspectFit"
            CacheDuration="30:00:00:00"
            DownsampleToViewSize="True"
            HeightRequest="250"
            Source="{Binding Media.ThumbUrl}" />

        <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto,Auto">
            <Label Grid.Row="0" Text="{Binding Media.Title}" FontSize="Title"/>

            <HorizontalStackLayout Grid.Row="1">
                <Label Text="{Binding Media.Year}" />
                <Label Text=" - " />
                <Label Text="{Binding Media.Duration, Converter={StaticResource BigIntToTimeString}}" />
            </HorizontalStackLayout>

            <Label Grid.Row="2" IsVisible="{Binding IsTvShow}" Text="{Binding Media.Season, StringFormat='{0} Seasons'}" />
        </Grid>

        <Label Grid.Row="1" Grid.ColumnSpan="2" Margin="0,15,0,0" Text="{Binding Media.Summary}" />
    </Grid>
</ContentPage>