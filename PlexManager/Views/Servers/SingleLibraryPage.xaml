<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PlexManager.Views.Servers.SingleLibraryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:actions="clr-namespace:PlexManager.Components.QuickActions"
             xmlns:medias="clr-namespace:PlexManager.Components.Medias"
             xmlns:helpers="clr-namespace:PlexManager.Helpers"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:plexservermodels="clr-namespace:PlexAPI.Models.Servers;assembly=PlexAPI"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:vm="clr-namespace:PlexManager.ViewModels.Servers"
             x:DataType="vm:SingleLibraryViewModel">
    <ContentPage.Resources>
        <helpers:IconTypeConverter x:Key="IconTypeConverter" />
        <helpers:EqualityConverter x:Key="EqualityConverter" />
        <helpers:NullToBooleanConverter x:Key="NullToBooleanConverter" />
    </ContentPage.Resources>

    <Grid Margin="0,5,0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
        
        <ActivityIndicator HorizontalOptions="Center"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="Center" />
        -->

        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <actions:Library />

                <Border Margin="10,5,10,5"
                        Padding="15"
                        StrokeShape="RoundRectangle 5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Margin="0,0,0,0"
                               FontSize="Medium"
                               HorizontalOptions="Center"
                               Text="Medias" />
                        <RefreshView>
                            <ScrollView>
                                <CollectionView ItemsSource="{Binding LibraryMovie.Videos}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="plexservermodels:LibraryMovieVideo">
                                            <Grid Margin="0,5,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ffimageloading:CachedImage Aspect="AspectFit"
                                                    CacheDuration="30:00:00:00"
                                                    DownsampleToViewSize="True"
                                                    HeightRequest="50"
                                                    Source="{Binding ThumbUrl}" />

                                                <Label Grid.Column="1"
                                                   Margin="5,0,0,0"
                                                   Text="{Binding Title}"
                                                   VerticalOptions="Center" />

                                                <ImageButton Grid.Column="2" Source="{mi:Material ChevronRight}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </ScrollView>
                        </RefreshView>
                        
                        
                        
                        <!--<medias:Movie Grid.Row="1"
                                                IsVisible="{Binding LibraryMovie, Converter={StaticResource NullToBooleanConverter}}" />

                        <medias:TvShow Grid.Row="1"
                                                 IsVisible="{Binding LibraryTvShow, Converter={StaticResource NullToBooleanConverter}}" />-->
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
