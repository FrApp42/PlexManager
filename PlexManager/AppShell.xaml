<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="PlexManager.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:PlexManager"
       xmlns:views="clr-namespace:PlexManager.Views"
       xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="True"
       Shell.BackgroundColor="#512bd4"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Title="PlexManager">
    <TabBar>
        <ShellContent Title="Servers"
                      Icon="{mi:Material Icon=Dns}"
                      ContentTemplate="{DataTemplate views:ServersPage}"
                      Route="ServersPage"
                      Shell.NavBarIsVisible="False" />

        <ShellContent Title="Settings"
                      Icon="{mi:Material Settings}"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="Settings"
                      Shell.NavBarIsVisible="False" />

        <ShellContent Title="About"
                      Icon="{mi:Material Icon=Info}"
                      ContentTemplate="{DataTemplate views:AboutPage}"
                      Route="About"
                      Shell.NavBarIsVisible="False" />
    </TabBar>
</Shell>
