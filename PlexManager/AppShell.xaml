<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PlexManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PlexManager"
    xmlns:view="clr-namespace:PlexManager.View"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    Shell.FlyoutBehavior="Disabled"   
    Shell.NavBarIsVisible="False"
    Title="PlexManager">

    <TabBar>
        <ShellContent
            Title="Servers"
            Icon="{mi:Material Icon=Dns}"
            ContentTemplate="{DataTemplate view:ServersPage}"
            Route="MainPage" />

        <ShellContent
             Title="Settings"
             Icon="{mi:Material Settings}"
             ContentTemplate="{DataTemplate view:ServersPage}"
             Route="Settings" />

        <ShellContent
             Title="About"
             Icon="{mi:Material Icon=Info}"
             ContentTemplate="{DataTemplate view:AboutPage}"
             Route="About" />

    </TabBar>

</Shell>
